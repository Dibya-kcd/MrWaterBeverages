# ============================================================================
# LOCAL DEVELOPMENT ONLY.  Save this file as  .env  (exactly that name, in the
# project root next to package.json).  It is already in .gitignore: never commit it.
# Replace every value that says CHANGE-ME.  No quotes, no spaces around "=".
# ============================================================================

# --- AI invoice reading (GRN upload). Create a NEW key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6Ko2Y3n17deR_vwm9Y8ADzBYMMcRZsvd6WPGjgxMrPd3Q

# --- Sign-in for the local server
