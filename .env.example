# GEMINI_API_KEY: used by the server to read supplier invoices (GRN upload). Keep it on the server only.
GEMINI_API_KEY=your-own-gemini-key

# Optional: comma separated Gemini model ids, BEST FIRST. Default (all free tier):
# gemini-3.8-flash, gemini-flash-latest, gemini-3.1-flash-lite
# GEMINI_MODELS=gemini-3.8-flash,gemini-flash-latest,gemini-3.1-flash-lite

# APP_URL: public address where this app is hosted (used for links and OAuth callbacks).
APP_URL=https://your-app.example.com

# Supabase PostgreSQL Database Configuration
# Use YOUR project's values. Never commit real ones.
VITE_SUPABASE_URL=https://psizakmtxppariejawbd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_3D3tfJOS10gkL0lJ6qQT1Q_Lvux1S9W


# --- Sign-in (security) ---
# There is NO built-in admin password. Create your admin user in Supabase Auth, or (offline / first set-up)
# choose your own secret of at least 8 characters for the local fallback login (user: admin):
# VITE_LOCAL_ADMIN_PASSWORD=
# One-click demo login is OFF unless this is "true". Never enable it in production.
# VITE_ENABLE_DEMO_LOGIN=false

# Minutes of inactivity before the app signs the user out (default 30, 0 = never).
# VITE_IDLE_LOGOUT_MINUTES=30

# --- Server-side sign-in and API protection (see security/RUNBOOK.md) ---
# Sign-in is ON by default. In production the server REFUSES TO START unless these are set:
APP_SESSION_SECRET=        # 32+ random characters, e.g. `openssl rand -hex 32`
ADMIN_PASSWORD=            # owner password checked on the server (never sent to the app)
ADMIN_EMAILS=              # recommended: only these Supabase Auth users count as owner
SUPABASE_URL=              # your project address (server)
SUPABASE_SERVICE_ROLE_KEY= # server only; never put this in a VITE_ variable
# Optional:
# PIN_PEPPER=              # extra server-only secret for salesman PIN hashes (defaults to APP_SESSION_SECRET)
# SALESMAN_CUSTOMER_DIRECTORY=true   # let salesmen see all customers' names/phones (never balances or limits)
# Developer machine only (ignored/refused in production):
# API_AUTH_REQUIRED=false
